{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WARFIRE RISES",
  "version": "2.0.0",
  "identifier": "com.warfire.rises",
  "build": {
    "beforeDevCommand": "./node_modules/.bin/vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "./node_modules/.bin/tsc --noEmit && ./node_modules/.bin/vite build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WARFIRE RISES — 战火升腾",
        "width": 1500,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' https://open.er-api.com https://news.google.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "HOI4-style world simulation game",
    "longDescription": "WARFIRE RISES — 战火升腾. A geopolitical world simulation with a Hearts of Iron IV style map and control panels."
  }
}
